    },
    {
      "collection": "zp_work_orders",
      "field": {
        "name": "permissionToEnter",
        "type": "boolean",
        "interface": "checkbox"
      }
    },
    {
      "collection": "zp_work_orders",
      "field": {
        "name": "requestSnapshot",
        "type": "text",
        "interface": "textarea"
      }
    }
  ],
  "security": {
    "receipts": "No generic CRUD for any role; command service transaction only.",
    "attachments": "Native attachment links; actual upload, creator scope and rendered retrieval require separate native acceptance.",
    "roles": "Add named maintenance manager snippet only to existing manager role; preserve all existing grants, scopes, portal roles and routes."
  }
