        {
          "name": "commandKey",
          "type": "string",
          "allowNull": false,
          "unique": true
        },
        {
          "name": "actorId",
          "type": "bigInt",
          "allowNull": false
        },
        {
          "name": "action",
          "type": "string",
          "allowNull": false
        },
        {
          "name": "requestId",
          "type": "string",
          "allowNull": false
        },
        {
          "name": "requestDigest",
          "type": "string",
          "allowNull": false
        },
        {
          "name": "outcome",
          "type": "string",
          "allowNull": false
        },
        {
          "name": "resultJSON",
          "type": "text",
          "allowNull": true
        },
        {
          "name": "errorCode",
          "type": "string",
          "allowNull": true
        }
      ]
    }
