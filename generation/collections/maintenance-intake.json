        "interface": "textarea"
      }
    },
    {
      "collection": "zp_maintenance_requests",
      "field": {
        "name": "attachments",
        "type": "belongsToMany",
        "target": "attachments",
        "interface": "attachment",
        "uiSchema": {
          "type": "array",
          "title": "Photos and files",
          "x-component": "Upload.Attachment",
          "x-use-component-props": "useAttachmentFieldProps",
          "x-component-props": {
            "multiple": true
          }
        }
      }
    },
    {
      "collection": "zp_work_orders",
      "field": {
        "name": "category",
        "type": "string",
        "interface": "input"
      }
    },
    {
      "collection": "zp_work_orders",
      "field": {
        "name": "preferredTimes",
        "type": "text",
        "interface": "textarea"
      }
    },
    {
      "collection": "zp_work_orders",
      "field": {
        "name": "petInformation",
        "type": "text",
        "interface": "textarea"
      }
    },
    {
      "collection": "zp_work_orders",
      "field": {
        "name": "attachments",
        "type": "belongsToMany",
        "target": "attachments",
        "interface": "attachment",
        "uiSchema": {
          "type": "array",
          "title": "Photos and files",
          "x-component": "Upload.Attachment",
          "x-use-component-props": "useAttachmentFieldProps",
          "x-component-props": {
            "multiple": true
          }
        }
      }
    },
    {
      "collection": "zp_work_orders",
      "field": {
        "name": "description",
        "type": "text",
        "interface": "textarea"
