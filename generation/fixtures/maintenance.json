  "bindingPolicy": "Coordinator resolves logical IDs from returned native readback through Loom. No direct REST/CLI/database mutations. Seed only after domain plugin guards are qualified.",
  "tests": [
    {
      "role": "zp_property_manager",
      "allow": "own graph record list/get",
      "deny": "other graph list/get and foreign ID filters; unrelated collection; create/delete; protected and nested field writes; builder routes"
    },
    {
      "role": "zp_owner",
      "allow": "own graph record list/get",
      "deny": "other graph list/get and foreign ID filters; unrelated collection; create/delete; protected and nested field writes; builder routes"
    },
    {
      "role": "zp_tenant",
      "allow": "own graph record list/get",
      "deny": "other graph list/get and foreign ID filters; unrelated collection; create/delete; protected and nested field writes; builder routes"
    },
    {
      "role": "zp_vendor",
      "allow": "own graph record list/get",
      "deny": "other graph list/get and foreign ID filters; unrelated collection; create/delete; protected and nested field writes; builder routes"
    },
    {
      "role": "zp_property_manager",
      "allow": "own work order new to quote with same-property compliant vendor; reload persists state/vendor",
      "deny": "foreign vendor; inactive/expired vendor; cross-property references; progress/complete/closed without approvals; protected approvalRequired/approvalGranted writes"
    }
  ],
  "verificationBoundary": "Direct native GET may verify reads. Writes use role-specific Loom credentials/instances or native end-user browser interactions, never root as a portal identity. Auth tokens and passwords stay in private runtime files."
