{
  "kind": "reviewable-desired-overlay",
  "executable": false,
  "order": "Required after initial page composition; resolve logical names to new native IDs on a new target",
  "maintenance": {
    "table": {
      "title": "Maintenance requests",
      "fieldOrder": [
        "title",
        "status",
        "property",
        "unit",
        "tenancy",
        "priority"
      ],
      "density": "middle",
      "pageSize": 15,
      "rowSelection": false,
      "recordActions": [
        "view"
      ],
      "removeAutoGenerated": [
        "addNew",
        "bulkDelete",
        "delete",
        "edit"
      ]
    },
    "requestPopup": {
      "detailsFields": [
        "title",
        "description",
        "property",
        "unit",
        "tenancy",
        "priority",
        "permissionToEnter",
        "status"
      ],
      "removeDuplicateWorkOrdersSubTable": true,
      "appendComposition": "request-linked-work.json"
    }
  },
  "linkedWork": {
    "title": "Work to arrange",
    "fieldOrder": [
      "state",
      "vendor",
      "title"
    ],
    "columnWidths": {
      "actions": 105,
      "state": 80,
      "vendor": 130,
      "title": 160
    },
    "rowSelection": false,
    "recordActions": [
      {
        "type": "edit",
        "title": "Assign vendor",
        "contextFields": [
          "title",
          "property",
          "unit",
          "tenancy"
        ],
        "editableFields": [
          "vendor",
          "state"
        ],
        "submitTitle": "Save assignment",
        "removeContextEditAction": true
      }
    ],
    "removeAutoGenerated": [
      "addNew",
      "bulkDelete",
      "delete",
      "view"
    ]
  },
  "workOrders": {
    "table": {
      "fieldOrder": [
        "title",
        "state",
        "property",
        "unit",
        "tenancy",
        "vendor"
      ],
      "density": "middle",
      "pageSize": 15,
      "rowSelection": false,
      "recordActions": [
        "view",
        "edit"
      ],
      "editTitle": "Assign vendor",
      "removeAutoGenerated": [
        "addNew",
        "bulkDelete",
        "delete"
      ]
    }
  },
  "acceptanceGates": [
    "native node readback",
    "effective manager contextual read grants with association guard",
    "eligible vendor selector",
    "role allow and deny",
    "fresh desktop and narrow journey"
  ],
  "observedBindings": [
    "../bindings/maintenance-composition.json",
    "../bindings/work-orders-composition.json",
    "../bindings/request-linked-work.json",
    "../bindings/linked-work-refinement.json"
  ],
  "vendorSelectorScope": {
    "targets": [
      "linked-work.vendor-input",
      "work-orders.edit.vendor-input"
    ],
    "intent": "Offer only active, unexpired vendors permitted for the current work order property",
    "tool": "lrs_scope_set",
    "precondition": "Read lrs_scope_get and use its exact current hash; verify current record propertyId is granted and available",
    "predicates": [
      {
        "field": "active",
        "operator": "eq",
        "value": {
          "literal": true
        }
      },
      {
        "field": "insuranceExpiresAt",
        "operator": "notExpired",
        "value": {
          "today": true
        }
      },
      {
        "field": "licenseExpiresAt",
        "operator": "notExpired",
        "value": {
          "today": true
        }
      },
      {
        "field": "propertyPermissions.propertyId",
        "operator": "eq",
        "value": {
          "currentRecordField": "propertyId"
        }
      }
    ],
    "bindings": [
      "generation/bindings/linked-vendor-selector-scope.json",
      "generation/bindings/main-vendor-selector-scope.json"
    ]
  }
}
