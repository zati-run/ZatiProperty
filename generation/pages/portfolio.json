                                      "fields": [
                                        "displayName",
                                        "partyRole",
                                        "revision",
                                        "effectiveFrom",
                                        "effectiveTo"
                                      ],
                                      "actions": [
                                        "filter",
                                        "refresh"
                                      ],
                                      "recordActions": []
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
