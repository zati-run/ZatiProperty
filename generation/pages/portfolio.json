      {
        "key": "properties",
        "type": "table",
        "resource": {
          "dataSourceKey": "main",
          "collectionName": "zp_properties"
        },
        "settings": {
          "title": "Properties",
          "pageSize": 20,
          "density": "middle",
          "enableRowSelection": false,
          "quickEdit": false,
          "dragSort": false
        },
        "fields": [
          "name",
          "address",
          "portfolio"
        ],
        "actions": [
          "filter",
          "refresh"
        ],
        "recordActions": [
          {
            "type": "view",
            "settings": {
              "title": "Property"
            },
            "popup": {
              "title": "Property",
              "mode": "drawer",
              "blocks": [
                {
                  "key": "property-summary",
                  "type": "details",
                  "resource": {
                    "binding": "currentRecord"
                  },
                  "settings": {
                    "title": "Property context",
                    "layout": "vertical",
                    "labelWrap": true
                  },
                  "fields": [
                    "name",
                    "address",
                    "portfolio"
                  ],
                  "actions": [],
                  "recordActions": []
                },
                {
                  "key": "units",
