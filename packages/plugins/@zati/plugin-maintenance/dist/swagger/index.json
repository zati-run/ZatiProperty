{
  "openapi": "3.0.0",
  "info": {
    "title": "ZatiProperty maintenance intake commands",
    "version": "0.2.0"
  },
  "paths": {
    "/zpMaintenance:createRequest": {
      "post": {
        "tags": [
          "zpMaintenance"
        ],
        "summary": "createRequest",
        "x-loom-command-contract": "idempotent-terminal-v1",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "propertyId": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "unitId": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "tenancyId": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "plumbing",
                      "electrical",
                      "appliance",
                      "structural",
                      "pest",
                      "general"
                    ]
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "urgent"
                    ]
                  },
                  "preferredTimes": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "permissionToEnter": {
                    "type": "boolean"
                  },
                  "petInformation": {
                    "type": "string",
                    "maxLength": 2000
                  }
                },
                "required": [
                  "requestId",
                  "propertyId",
                  "title",
                  "description",
                  "category",
                  "priority",
                  "permissionToEnter"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Committed result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "requestId": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "propertyId": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "status": {
                          "type": "string"
                        },
                        "state": {
                          "type": "string"
                        },
                        "alreadyConverted": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/zpMaintenance:convertRequest": {
      "post": {
        "tags": [
          "zpMaintenance"
        ],
        "summary": "convertRequest",
        "x-loom-command-contract": "idempotent-terminal-v1",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "maintenanceRequestId": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "requestId",
                  "maintenanceRequestId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Committed result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "requestId": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "propertyId": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "status": {
                          "type": "string"
                        },
                        "state": {
                          "type": "string"
                        },
                        "alreadyConverted": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/zpMaintenance:reconcileCommand": {
      "get": {
        "tags": [
          "ZatiProperty protected tenancy and ownership"
        ],
        "summary": "Read own committed command receipt without initiating or retrying work",
        "parameters": [
          {
            "name": "commandAction",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "createRequest",
                "convertRequest"
              ]
            }
          },
          {
            "name": "requestId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Persisted committed or rejected outcome, or uncertain not_observed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "receiptVersion": {
                          "type": "integer",
                          "enum": [
                            1
                          ]
                        },
                        "actorId": {
                          "type": "string"
                        },
                        "commandAction": {
                          "type": "string"
                        },
                        "requestId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "requestDigest": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "committed",
                            "rejected",
                            "not_observed"
                          ]
                        },
                        "outcome": {
                          "type": "string",
                          "enum": [
                            "committed",
                            "rejected"
                          ]
                        },
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "result": {
                          "type": "object"
                        },
                        "retryAuthorized": {
                          "type": "boolean",
                          "enum": [
                            false
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Original action or reconciliation ACL denied"
          },
          "409": {
            "description": "Stable machine error code and safe recovery message; ambiguous outcomes require reconciliation, never blind replay."
          }
        },
        "x-loom-command-contract": "idempotent-terminal-v1",
        "description": "Read-only actor and original-action authorized lookup. receiptVersion 1 identifies a persisted outcome; requestDigest is canonical SHA256 excluding requestId. Rejected outcomes permit correction only after matching actorId, commandAction, requestId and requestDigest. not_observed never authorizes automatic replay."
      }
    }
  }
}
