  "paths": {
    "/zpPropertyTenancy:createDraftTenancy": {
      "post": {
        "operationId": "zpPropertyTenancy_createDraftTenancy",
        "summary": "Protected createDraftTenancy",
        "tags": [
          "ZatiProperty domain"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "unitId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "startDate": {
                    "type": "string",
                    "format": "date"
                  },
                  "endDate": {
                    "type": "string",
                    "format": "date",
                    "nullable": true
                  },
                  "term": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "effectiveFrom": {
                        "type": "string",
                        "format": "date"
                      },
                      "effectiveTo": {
                        "type": "string",
                        "format": "date",
                        "nullable": true
                      },
                      "currency": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$"
                      },
                      "rentMinor": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2147483647
                      },
                      "depositMinor": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2147483647
                      },
                      "rentFrequency": {
                        "type": "string",
                        "enum": [
                          "weekly",
                          "fortnightly",
                          "monthly",
                          "quarterly",
                          "annually"
                        ]
                      },
                      "dueDay": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 31
                      },
                      "prorationPolicy": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      }
                    },
                    "required": [
                      "effectiveFrom",
                      "currency",
                      "rentMinor",
                      "depositMinor",
                      "rentFrequency",
                      "dueDay",
                      "prorationPolicy"
                    ]
                  },
                  "parties": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "displayName": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "userId": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "partyRole": {
                          "type": "string",
                          "enum": [
                            "primary",
                            "cotenant",
                            "guarantor",
                            "occupant"
                          ]
                        },
                        "effectiveFrom": {
                          "type": "string",
                          "format": "date"
                        },
                        "effectiveTo": {
                          "type": "string",
                          "format": "date",
                          "nullable": true
                        }
                      },
                      "required": [
                        "displayName",
                        "partyRole",
                        "effectiveFrom"
                      ]
                    }
                  },
                  "reasonCode": {
                    "type": "string",
                    "enum": [
                      "initial-setup",
                      "correction",
                      "activation-reviewed",
                      "move-out-confirmed",
                      "ownership-reviewed",
                      "legacy-reviewed",
                      "account-authorized"
                    ]
                  }
                },
                "required": [
                  "unitId",
                  "code",
                  "startDate",
                  "term",
                  "parties",
                  "reasonCode"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Committed domain result"
          },
          "403": {
            "description": "Role or property scope denied"
          },
          "409": {
            "description": "Invariant, version or persistence failure; reconcile before retry"
          }
        }
      }
    },
