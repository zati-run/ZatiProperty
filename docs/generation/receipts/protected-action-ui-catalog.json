{
  "key": "js",
  "label": "JS action",
  "use": "JSFormActionModel",
  "kind": "action",
  "scope": "form",
  "scene": "form",
  "createSupported": true,
  "configureOptions": {
    "title": {
      "type": "string",
      "description": "Button title",
      "example": "Run"
    },
    "tooltip": {
      "type": "string",
      "description": "Tooltip"
    },
    "icon": {
      "type": "string",
      "description": "Icon",
      "example": "PlusOutlined"
    },
    "iconOnly": {
      "type": "boolean",
      "description": "Whether to render only the icon without visible button text",
      "example": true
    },
    "type": {
      "type": "string",
      "description": "Button type",
      "example": "primary"
    },
    "color": {
      "type": "string",
      "description": "Color"
    },
    "htmlType": {
      "type": "string",
      "description": "HTML button type",
      "example": "submit"
    },
    "position": {
      "type": "string",
      "description": "Position"
    },
    "danger": {
      "type": "boolean",
      "description": "Whether this is a danger button",
      "example": false
    },
    "code": {
      "type": "string",
      "description": "JS code",
      "example": "return value?.toUpperCase?.() || value;"
    },
    "version": {
      "type": "string",
      "description": "JS code version",
      "example": "v2"
    },
    "linkageRules": {
      "type": "array",
      "description": "Raw canonical linkage-rules payload. The API normalizes condition-only rules to include `actions: []`; for AI/CLI authoring, prefer `getReactionMeta` + `setActionLinkageRules` instead of guessing this configure key directly.",
      "example": [],
      "supportsFlowContext": true
    }
  },
